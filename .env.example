# Required for live Gemini audio transcription, interviewer turns, and debrief generation.
# Leave blank to run in local Demo Mode (simulated responses, no external API calls).
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
GEMINI_INTERVIEWER_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_MODEL=gemini-2.5-flash

# Optional backend host/port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
